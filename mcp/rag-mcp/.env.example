# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB settings — where to persist the vector store on disk
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION=rag_mcp_docs

# Chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Directory where documents to index live
DOCUMENTS_DIR=data/documents
